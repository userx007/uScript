---
Language: Cpp
BasedOnStyle: LLVM

BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction:        true
  AfterClass:           true
  AfterControlStatement: false
  AfterEnum:            false
  AfterNamespace:       false
  AfterStruct:          true
  AfterUnion:           false
  AfterExternBlock:     false
  BeforeCatch:          false
  BeforeElse:           false
  BeforeWhile:          false
  IndentBraces:         false
  SplitEmptyFunction:   false
  SplitEmptyRecord:     false
  SplitEmptyNamespace:  false

# Always add braces to if/else/for/while/do bodies, even single statements
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false

# Local/project header first, system headers after
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:    '^".*'
    Priority: 1
  - Regex:    '^<.*>'
    Priority: 2

# Ignore line length entirely
ColumnLimit: 0

# Constructor initializer list: always one per line, leading comma aligned under the colon
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never

# Class members/methods stay at the same indent regardless of access specifier
AccessModifierOffset: -4
IndentAccessModifiers: false
IndentWidth: 4

# Spaces only, never tabs (trailing whitespace/tabs are always stripped by clang-format)
UseTab: Never
TabWidth: 4

# Align "=" across consecutive enum values
AlignConsecutiveAssignments: AcrossEmptyLinesAndComments

# Align values across consecutive #define macros
AlignConsecutiveMacros: AcrossEmptyLinesAndComments

SeparateDefinitionBlocks: Always