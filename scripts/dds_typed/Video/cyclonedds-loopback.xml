<?xml version="1.0" encoding="UTF-8"?>

<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="0">
    <General>
      <Interfaces>
        <NetworkInterface address="127.0.0.1"/>
      </Interfaces>
      <Transport>udp</Transport>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <SharedMemory>
      <Enable>false</Enable>
